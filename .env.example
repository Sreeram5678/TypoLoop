# TypoLoop Environment Variables

# 1. Local Ollama (Default Edge AI Provider)
# Set your local Ollama endpoint URL (default is http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Recommended Ollama Models for TypoLoop:
# - gemma4:e2b   (Deep Thinking Mode, edge biomechanical reasoning)
# - gemma2:2b    (Ultralight 1.6GB VRAM, instantaneous latency)

# 2. Google AI Studio / Gemini API (Optional Cloud Fallback)
# Get a free API key at: https://aistudio.google.com
# Can also be set in-app via the Settings modal (Sliders icon)
GOOGLE_API_KEY=
GEMINI_API_KEY=
